# URL pública COM basePath
NEXT_PUBLIC_BASE_URL=http://179.197.65.2:3060/diagnostico

# Origem pública (LP + quiz no mesmo host)
NEXT_PUBLIC_SITE_ORIGIN=http://179.197.65.2:3060

# Chromium bate no Next interno — nunca no domínio do proxy
PDF_INTERNAL_BASE_URL=http://127.0.0.1:3000/diagnostico

# Disco persistente dos laudos (VPS)
DATA_DIR=/data

# Binário do Chromium no container
CHROMIUM_PATH=/usr/bin/chromium

# Opcional: espelho de leads
SHEETS_WEBHOOK_URL=

# RD Station Marketing — token público envia o lead (API 1.2/conversão)
# https://developers.rdstation.com/reference/conversao
RD_STATION_PUBLIC_TOKEN=
RD_STATION_PRIVATE_TOKEN=
RD_STATION_API_KEY=
RD_STATION_CONVERSION_IDENTIFIER=diagnostico-oficina-quiz

# Analytics
NEXT_PUBLIC_GTM_ID=
